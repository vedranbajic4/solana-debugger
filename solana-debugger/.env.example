# .env
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SURFNET_RPC=http://127.0.0.1:8899

# Optional. An RPC that serves *historical* account state, used to give the fork
# the program-owned data (pool reserves, oracle prices, open orders) that
# transaction metadata never records. Needs a provider that implements
# getAccountInfo with a `lastUpdateBeforeSlot` parameter — Alchemy's Solana
# Account Archive does; a normal endpoint silently ignores it and is detected
# and refused rather than trusted.
#
# Leaving this unset is fine: replays fall back to present-day account state and
# say so.
# ARCHIVE_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
