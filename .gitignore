# ==========================================
# TypeScript & Build Output
# ==========================================
# Ignore the directory where TypeScript compiles JavaScript files
# NOTE: no `lib/` rule here — this project has no build step (tsx runs the .ts
# files directly) and `solana-debugger/lib/` is hand-written source.
dist/
out/
build/

# Ignore TypeScript build cache and incremental compilation data
*.tsbuildinfo

# Ignore source maps if you don't want to track them
*.js.map
*.d.ts.map

# Optionally ignore compiled JS files if they live next to TS files
# (Uncomment the line below if you compile files in place)
# src/**/*.js

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
typings/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Scratch CLI output captured while debugging (regenerable via `npm run fetch`)
demo-*.txt

# ==========================================
# Logs & Runtime
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# IDEs & Editor Configuration
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db


# Cached on-chain Anchor IDLs (lib/idl-cache.ts) — regenerable, machine-local
solana-debugger/.idl-cache/
