# ==========================================
# TypeScript & Build Output
# ==========================================
# Ignore the directory where TypeScript compiles JavaScript files
dist/
out/
build/
lib/

# Ignore TypeScript build cache and incremental compilation data
*.tsbuildinfo

# Ignore source maps if you don't want to track them
*.js.map
*.d.ts.map

# Optionally ignore compiled JS files if they live next to TS files
# (Uncomment the line below if you compile files in place)
# src/**/*.js

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
typings/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==========================================
# Logs & Runtime
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# IDEs & Editor Configuration
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db

